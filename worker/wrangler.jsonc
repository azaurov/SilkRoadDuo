{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silk-road-duo-battle",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",

  "durable_objects": {
    "bindings": [
      { "name": "BATTLE_ROOM", "class_name": "BattleRoom" }
    ]
  },

  // Per-IP limit on /lesson (each call spends provider quota). Secrets are set with
  // `wrangler secret put GROQ_API_KEY` / OPENROUTER_API_KEY / GEMINI_API_KEY -- never in this file.
  "ratelimits": [
    { "name": "LESSON_LIMITER", "namespace_id": "5101", "simple": { "limit": 8, "period": 60 } }
  ],

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }
  ],

  "d1_databases": [
    {
      "binding": "PROFILES_DB",
      "database_name": "silk-road-duo-profiles",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}

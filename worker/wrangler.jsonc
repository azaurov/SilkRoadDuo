{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silk-road-duo-battle",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",

  "durable_objects": {
    "bindings": [
      { "name": "BATTLE_ROOM", "class_name": "BattleRoom" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }
  ]
}
